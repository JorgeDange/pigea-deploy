# ============================================================
# PIGEA — .env.example (template para produção)
# Copiar para .env no servidor e preencher os valores reais.
# NUNCA commitar este ficheiro preenchido com segredos.
# ============================================================

APP_NAME=PIGEA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Luanda
APP_URL=https://pigea.qnbangola.ao/laravel

# O projeto instala `lang/pt`; com `en` o framework devolve as *chaves*
# (`validation.required`) em vez de mensagens ao utilizador.
APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=pt_PT
APP_FAKER_LOCALE=pt_PT

# Caminho do painel admin (obscurece o "/admin" óbvio a varrimentos).
# Só muda o prefixo da URL; os nomes das rotas continuam admin.*.
# Em produção trocar o valor por um próprio (não deixar o default).
ADMIN_PATH=admin
PIGEA_LOGIN_PATH=painel-autenticacao

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pigea
DB_USERNAME=pigea
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# true = o conteúdo do cookie de sessão é encriptado (produção DEVE usar true).
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# EMAIL — OBRIGATÓRIO para a Newsletter distribuir confirmações.
# Por omissão, todos os emails ficam em storage/logs/laravel.log
# (envio desligado). Preencher com credenciais reais para produção:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.exemplo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=conta@pigea.ao
#   MAIL_PASSWORD=(segredo do fornecedor)
#   MAIL_ENCRYPTION=tls
# ============================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@pigea.ao"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Área pública de Projetos — desligada por omissão (config/features.php;
# decisão do cliente 2026-11-13). Ligar apenas quando o cliente decidir
# implementar (php artisan migrate + ligação nos menus).
PROJECTS_PUBLICO=false
